# 开发环境配置
VITE_API_PROXY_TARGET=http://localhost:8088
VITE_PYTHON_API_PROXY_TARGET=http://127.0.0.1:8001

# 真实大模型联调请在 .env.development.local 中开启：
# VITE_USE_REAL_AI_API=true
# VITE_USE_REAL_OUTLINE_API=true
# VITE_JAVA_API_PROXY_TARGET=http://localhost:8088
# /api/v1/python 由 Vite 直达 FastAPI；其余业务接口交给 Java。
