OPENAI_API_KEY=
# 浏览器直连时由 FastAPI 使用 Java /users/me 验证同一份登录令牌。
JAVA_AUTH_BASE_URL=http://127.0.0.1:8088
A12_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8888,http://127.0.0.1:8888
# Java 与 FastAPI 同时配置相同的随机长密钥，供 Java 后台任务调用 Python；不要写入前端环境变量。
A12_PYTHON_INTERNAL_KEY=
A12_RESOURCE_REDIS_URL=redis://127.0.0.1:6379/0
A12_COMMUNITY_REVIEW_WORKERS=3
# Python 每次请求及模型调用前校验 Java 登录令牌；通常与资源事件使用同一 Redis。
A12_AUTH_REDIS_URL=redis://127.0.0.1:6379/0
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 按任务路由；留空时回退 OPENAI_MODEL。前端选择“快速/标准/深度”会真实传到后端。
OPENAI_MODEL_FAST=
OPENAI_MODEL_STANDARD=
OPENAI_MODEL_DEEP=
OPENAI_MODEL_VISION=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RETRIEVAL_MIN_SCORE=0.18
ASR_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
# ASR 独立接入（可选）：指向与 OPENAI_BASE_URL 不同的平台；未设置时回落 OPENAI_API_KEY/OPENAI_BASE_URL
# 示例（硅基流动，SenseVoice 转写免费、原生 OpenAI transcriptions 兼容）：
#   ASR_BASE_URL=https://api.siliconflow.cn/v1
#   ASR_API_KEY=sk-xxxx
#   ASR_MODEL=FunAudioLLM/SenseVoiceSmall
#ASR_BASE_URL=
#ASR_API_KEY=
REQUEST_TIMEOUT_SECONDS=120
# 资源索引下载+解析整体限时（秒）：卡死按超时转 failed，必须小于 Java→Python 的 600s 超时
INDEX_PARSE_TIMEOUT_SECONDS=540
# 资源解析的视觉理解开关（逐图调用主 LLM，图片多时耗时线性增长）：
# 仅当 OPENAI_MODEL 支持图片输入时开启；LongCat 等纯文本模型保持 false（OCR 兜底仍生效）
ENABLE_VISION_PARSE=false
# PPT 自动配图（可选）。未填写 Key 时，auto/generate 会安全降级成智能占位，不影响课件生成。
# 默认使用百炼万相极速模型；业务空间专属域名可替换 IMAGE_GENERATION_BASE_URL。
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_GENERATION_MODEL=wan2.2-t2i-flash
IMAGE_GENERATION_TIMEOUT_SECONDS=150
IMAGE_GENERATION_POLL_INTERVAL_SECONDS=5
# 每套课件最多生成的图片数，用于控制费用与等待时间。
MAX_GENERATED_IMAGES=4
MAX_SLIDE_CONCURRENCY=8
MAX_HTML_RETRIES=1
ENABLE_QUALITY_PIPELINE=true
QUALITY_PRESET=fast
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/postgres
ENABLE_AUTONOMOUS_TOOLS=true
ENABLE_MCP_TOOLS=false
MCP_SERVERS=
TOOL_CALL_TIMEOUT_SECONDS=30
MCP_DISCOVERY_TIMEOUT_SECONDS=15
MCP_TOOL_CACHE_TTL_SECONDS=300
# MCP_SERVERS={"python_mcp":{"transport":"sse","url":"http://127.0.0.1:8080/sse"},"my12306":{"type":"streamable_http","url":"https://mcp.api-inference.modelscope.net/4f392bf4ab6c4f/mcp"},"chart":{"type":"streamable_http","url":"https://mcp.api-inference.modelscope.net/110954b8d2f54c/mcp"}}
