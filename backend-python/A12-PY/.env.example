# Bailian/DashScope is the default provider for mainland China non-VPN runtime.
# If a variable is empty or omitted, backend-python falls back to the defaults in a12_ppt/config.py.
# Priority: module-specific key/base_url > OPENAI_* > DASHSCOPE_* > built-in Bailian defaults.

# Recommended: set this one key for chat, embedding and ASR.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Chat model. OPENAI_* names are kept for OpenAI-compatible SDK/frameworks.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=qwen-plus
PPT_HTML_MODEL=qwen-turbo

# Embedding model for RAG index/search.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=

# Speech recognition. Defaults to Bailian-compatible ASR.
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=qwen3-asr-flash

REQUEST_TIMEOUT_SECONDS=240
MAX_SLIDE_CONCURRENCY=12
MAX_HTML_RETRIES=1
ENABLE_QUALITY_PIPELINE=true
ENABLE_AUTONOMOUS_TOOLS=true
QUALITY_PRESET=fast
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/postgres
