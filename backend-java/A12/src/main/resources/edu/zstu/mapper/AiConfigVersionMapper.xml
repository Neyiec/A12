<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.zstu.mapper.AiConfigVersionMapper">

    <resultMap id="BaseResultMap" type="edu.zstu.entity.AiConfigVersion">
        <id column="id" property="id"/>
        <result column="config_id" property="configId"/>
        <result column="version" property="version"/>
        <result column="config_value" property="configValue"/>
        <result column="reason" property="reason"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt" javaType="java.time.LocalDateTime"/>
    </resultMap>

    <sql id="Base_Columns">
        id, config_id, version, config_value, reason, created_by, created_at
    </sql>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/> FROM ai_config_version WHERE id = #{id}
    </select>

    <select id="findByConfigId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/> FROM ai_config_version WHERE config_id = #{configId} ORDER BY version DESC
    </select>

    <select id="findByConfigIdAndVersion" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/> FROM ai_config_version WHERE config_id = #{configId} AND version = #{version}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_config_version(config_id, version, config_value, reason, created_by, created_at)
        VALUES(#{configId}, #{version}, #{configValue}, #{reason}, #{createdBy}, #{createdAt})
    </insert>
</mapper>
