<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.zstu.mapper.SysConfigMapper">

    <resultMap id="BaseResultMap" type="edu.zstu.entity.Sys_Config">
        <id column="id" property="id"/>
        <result column="config_group" property="config_group"/>
        <result column="config_key" property="config_key"/>
        <result column="config_value" property="config_value"/>
        <result column="description" property="description"/>
        <result column="updated_by" property="updated_by"/>
        <result column="updated_at" property="updated_at"/>
    </resultMap>

    <sql id="Base_Columns">
        id, config_group, config_key, config_value, description, updated_by, updated_at
    </sql>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/> FROM sys_config WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/> FROM sys_config
    </select>

    <select id="findByGroup" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/> FROM sys_config WHERE config_group = #{configGroup}
    </select>

    <select id="findByGroupAndKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/> FROM sys_config WHERE config_group = #{configGroup} AND config_key = #{configKey}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_config(config_group, config_key, config_value, description, updated_by, updated_at)
        VALUES(#{config_group}, #{config_key}, #{config_value}, #{description}, #{updated_by}, #{updated_at})
    </insert>

    <update id="update">
        UPDATE sys_config
        <set>
            <if test="config_group != null">config_group = #{config_group},</if>
            <if test="config_key != null">config_key = #{config_key},</if>
            <if test="config_value != null">config_value = #{config_value},</if>
            <if test="description != null">description = #{description},</if>
            <if test="updated_by != null">updated_by = #{updated_by},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_config WHERE id = #{id}
    </delete>
</mapper>
