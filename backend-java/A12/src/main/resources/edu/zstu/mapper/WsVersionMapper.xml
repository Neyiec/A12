<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.zstu.mapper.WsVersionMapper">
    <resultMap id="BaseResultMap" type="edu.zstu.entity.Ws_Version">
        <id column="id" property="id"/>
        <result column="project_id" property="project_id"/>
        <result column="version_number" property="version_number"/>
        <result column="description" property="description"/>
        <result column="created_at" property="created_at"/>
    </resultMap>
    <sql id="Base_Columns">id, project_id, version_number, description, created_at</sql>
    <select id="findById" resultMap="BaseResultMap">SELECT <include refid="Base_Columns"/> FROM ws_version WHERE id = #{id}</select>
    <select id="findByProjectId" resultMap="BaseResultMap">SELECT <include refid="Base_Columns"/> FROM ws_version WHERE project_id = #{projectId} ORDER BY version_number DESC</select>
    <select id="findMaxVersionNumber" resultType="int">SELECT COALESCE(MAX(version_number), 0) FROM ws_version WHERE project_id = #{projectId}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ws_version(project_id, version_number, description, created_at)
        VALUES(#{project_id}, #{version_number}, #{description}, NOW())
    </insert>
    <delete id="deleteByProjectId">DELETE FROM ws_version WHERE project_id = #{projectId}</delete>
</mapper>
